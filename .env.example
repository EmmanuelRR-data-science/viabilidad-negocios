# =====================================================================
# Geo Viabilidad Negocios — Variables compartidas (docker-compose raíz)
# =====================================================================

# --- BASE DE DATOS (PostgreSQL + PostGIS) ---
DB_USER=admin
DB_PASSWORD=admin_password_safe
DB_HOST=127.0.0.1
DB_PORT=5435
DB_NAME=geoanalisis

# --- ENTORNO Y CONTROL DE DESARROLLO ---
# Local / equipo: DEV_MODE=true (Groq, sin AWS obligatorio)
DEV_MODE=true
# Pagos: tres modos (reinicia web-api tras cambiar):
#   PAYMENTS_MOCK=true  → modal simulado en la app (validación sin MP; localhost OK)
#   PAYMENTS_MOCK=false + MERCADOPAGO_SANDBOX=true  → Checkout Pro sandbox (requiere PUBLIC_APP_URL HTTPS/ngrok)
#   PAYMENTS_MOCK=false + MERCADOPAGO_SANDBOX=false + credenciales de producción → cobros reales
PAYMENTS_MOCK=true
# PDFs en disco local (scratch/reports). En VPS/producción: REPORTS_LOCAL_STORAGE=false
REPORTS_LOCAL_STORAGE=true

# --- AWS (S3, Bedrock, SES) ---
AWS_REGION=us-east-1
S3_REPORTS_BUCKET=viabilidad-hook-informes
BEDROCK_MODEL_ID=meta.llama3-70b-instruct-v1:0

# --- MERCADO PAGO (solo cuando PAYMENTS_MOCK=false) ---
# Sandbox: credenciales de prueba en developers.mercadopago.com
# Producción: credenciales live + MERCADOPAGO_SANDBOX=false + PUBLIC_APP_URL con dominio real
MERCADOPAGO_ACCESS_TOKEN=tu_access_token
MERCADOPAGO_PUBLIC_KEY=tu_public_key
MERCADOPAGO_SANDBOX=true
# Legacy (no usado): checkout invitado sin pre-cargar comprador.
# MERCADOPAGO_TEST_BUYER_EMAIL=

# --- GOOGLE ---
GOOGLE_PLACES_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=tu_client_id.apps.googleusercontent.com
PUBLIC_APP_URL=https://tu-dominio.ngrok-free.dev

# --- SESIÓN DE APP (JWT propio; no reutiliza el ID token de Google) ---
# Obligatorio en producción (DEV_MODE=false): ≥32 caracteres, no uses el default de DEV.
SESSION_SECRET=cambia-este-secreto-largo-y-aleatorio-min-32chars
SESSION_TTL_SECONDS=3600
DOWNLOAD_TOKEN_TTL_SECONDS=600

# CORS allowlist (coma-separada). En prod se exige CORS_ORIGINS o PUBLIC_APP_URL.
# CORS_ORIGINS=https://tu-dominio.ngrok-free.dev,http://localhost:8000

# Firma secreta de webhooks Mercado Pago (panel → Webhooks → Configure)
MERCADOPAGO_WEBHOOK_SECRET=

# --- LLM PROVIDER (groq | openai | bedrock) ---
LLM_PROVIDER=groq

# --- GROQ ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- OPENAI (alternativa a Groq para dev local) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- BESTTIME ---
# Clave PRIVADA de BestTime (debe empezar con pri_...). La clave pub_... NO sirve para crear forecasts.
BESTTIME_API_KEY=
BEST_TIME_API_KEY=

# --- PANEL ADMIN (Flask, puerto 8501) ---
ADMIN_USERNAME=PhiQus
ADMIN_PASSWORD=viabilidad-negocios
ADMIN_SECRET_KEY=genera-un-secreto-largo-aleatorio
ADMIN_MAX_UPLOAD_MB=600
FLASK_DEBUG=1
